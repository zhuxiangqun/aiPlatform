# FDE optional independent deploy — ADR-09 BOUNDARY B
# Status: wording + flags only. Co-deploy with control plane remains production default.
# NOT compose long-running. See reports/five-products/ADR09_FDE_BOUNDARY.md
#
# Copy (only if running an optional FDE-focused process):
#   cp fde_optional.env.example .env.fde-optional
#
# Unique signoff (do not invent a second path):
#   POST /api/platform/apps/fde/acceptance/signoff

# Slice: require diagnosis report_id on signoff (1=on; 0=emergency rollback only)
AIPLAT_FDE_REQUIRE_DIAG_REPORT_FOR_SLICE=1

# Optional display name (existing)
# AIPLAT_FDE_NAME=FDE

# Notify (existing gateway notifier; unrelated to deploy split)
# AIPLAT_FDE_NOTIFY_ENABLED=true
# AIPLAT_FDE_NOTIFY_CHANNELS=feishu,wecom,slack

# Placeholder for BOUNDARY C (one-shot health / optional process) — leave unset until wired
# AIPLAT_FDE_OPTIONAL_SPLIT=0
