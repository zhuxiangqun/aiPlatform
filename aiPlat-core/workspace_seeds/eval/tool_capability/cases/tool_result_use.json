        "args": {
          "text": "prep"
        }
      },
      {
        "name": "lookup_fact",
        "args": {
          "key": "alpha"
        }
      }
    ],
    "scripted_answer": "prep 后得到 42",
    "must_contain_from_tools": [
      "42",
      "prep"
    ],
    "test_purpose": {
      "summary": "验证多工具结果信号均写入答案",
      "why_this_case": "多结果漏引用是 A5 常见失败",
      "expected_behavior": [
        "含 42",
        "含 prep"
      ],
      "failure_signals": [
        "只写其一"
      ],
      "not_testing": [
        "不测顺序裁判",
        "不测 live MCP"
      ],
      "oracle_rationale": "规则 oracle：多 must_contain_from_tools"
    }
  },
