[
  {
    "case_id": "tool.tool_result_use.001",
    "capabilities": [
      "tool_result_use"
    ],
    "prompt": "查 key=alpha 并用结果回答。",
    "expected_tools": [
      "lookup_fact"
    ],
    "scripted_tool_calls": [
      {
        "name": "lookup_fact",
        "args": {
          "key": "alpha"
        }
      }
    ],
    "scripted_answer": "查到的值为 42。",
    "must_contain_from_tools": [
      "42"
    ],
    "use_tool_result_values": false,
    "test_purpose": {
      "summary": "验证回答引用 lookup_fact 返回值 42",
      "why_this_case": "Tool Subject A5 正例",
      "expected_behavior": [
        "回答含 42"
      ],
      "failure_signals": [
        "忽略工具结果"
      ],
      "not_testing": [
        "不测工具选择顺序",
        "不测 live MCP"
      ],
      "oracle_rationale": "规则 oracle：must_contain_from_tools / answer（tool_trace）"
    }
  },
  {
    "case_id": "tool.tool_result_use.002",
    "capabilities": [
      "tool_result_use"
    ],
    "prompt": "回显 token 并写入答案。",
    "expected_tools": [
      "echo"
    ],
    "scripted_tool_calls": [
      {
        "name": "echo",
        "args": {
          "text": "mirror-77"
        }
      }
    ],
    "scripted_answer": "工具回显：mirror-77",
    "use_tool_result_values": true,
    "test_purpose": {
      "summary": "验证回答吸收 echo 工具结果字符串",
      "why_this_case": "A5 use_tool_result_values 自动派生锚点",
      "expected_behavior": [
        "答案含 mirror-77"
      ],
      "failure_signals": [
        "答案丢回显值"
      ],
      "not_testing": [
        "不测选择集",
        "不测 live MCP"
      ],
      "oracle_rationale": "规则 oracle：flatten tool_results → must_contain"
    }
  },
  {
    "case_id": "tool.tool_result_use.003",
    "capabilities": [
      "tool_result_use"
    ],
    "prompt": "查事实并禁止编造其它码。",
    "expected_tools": [
      "lookup_fact"
    ],
    "scripted_tool_calls": [
      {
        "name": "lookup_fact",
        "args": {
          "key": "alpha"
        }
      }
    ],
    "scripted_answer": "官方值 42。",
    "must_contain_from_tools": [
      "42"
    ],
    "must_not_contain": [
      "999"
    ],
    "test_purpose": {
      "summary": "验证答案含 42 且不含伪造码 999",
      "why_this_case": "A5 正/负锚点同时约束",
      "expected_behavior": [
        "含 42",
        "不含 999"
      ],
      "failure_signals": [
        "漏 42",
        "掺入 999"
      ],
      "not_testing": [
        "不测 live MCP",
        "不测多轮"
      ],
      "oracle_rationale": "规则 oracle：must_contain + must_not_contain"
    }
  },
  {
    "case_id": "tool.tool_result_use.004",
    "capabilities": [
      "tool_result_use"
    ],
    "prompt": "先 echo 再 lookup，答案引用查表值。",
    "expected_tools": [
      "echo",
      "lookup_fact"
    ],
    "scripted_tool_calls": [
      {
