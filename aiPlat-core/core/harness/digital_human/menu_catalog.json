    {
      "id": "app_factory",
      "title": "应用工厂（需求→团队流水线→部署）",
      "menu": "/app/factory",
      "when": "要完整产品/应用，走默认研发团队 stages"
    },
    {
      "id": "workspace_skill",
      "title": "新建 Skill",
      "menu": "/workspace/skills",
      "when": "可复用动作、输入输出清楚，不必整条工厂"
    },
    {
      "id": "workspace_tool",
      "title": "新建 Tool",
      "menu": "/workspace/tools",
      "when": "原子操作（算一下/调 API），非完整应用"
    },
    {
      "id": "workspace_mcp",
      "title": "接入 MCP",
      "menu": "/workspace/mcp",
      "when": "接外部工具服务，优先于新写核心 Tool"
    },
    {
      "id": "workspace_agent",
      "title": "新建/执行 Agent",
      "menu": "/workspace/agents",
      "when": "已有或需单独会话编排的角色"
    },
    {
      "id": "fde",
      "title": "FDE 交付工作台",
      "menu": "/diagnostics/fde",
      "when": "交付诊断、证据、签收类，不走研发流水线"
    },
    {
      "id": "video_simple",
      "title": "视频理解样例（精简）",
      "agent": "video_understanding_agent",
      "menu": "/workspace/agents",
      "when": "工作区内试跑样例；用户要自己的视频应用仍走应用工厂，不可用本条顶替"
    },
    {
      "id": "video_orchestrated",
      "title": "视频编排样例（画面/语音/字幕）",
      "agent": "videosense_orchestrator",
      "menu": "/workspace/agents",
      "when": "工作区内试跑样例编排；用户要自己的视频应用仍走应用工厂，不可用本条顶替"
    }
  ]
