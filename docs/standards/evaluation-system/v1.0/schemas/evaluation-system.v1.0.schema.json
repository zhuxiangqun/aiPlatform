{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiplat.local/schemas/evaluation-system/v1.0",
  "title": "aiPlat Evaluation System Standard Schemas v1.0",
  "description": "Normative JSON Schemas for evaluation-system v1.0. Field authority: normative-appendix.md. Approving this schema ≠ implementation certified.",
  "type": "object",
  "$defs": {
    "evidence_ref": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true,
          "patternProperties": { "^x-": {} }
        }
      ]
    },
    "fingerprints": {
      "type": "object",
      "required": ["plan_id", "manifest_hash", "execution_fingerprint"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "manifest_hash": { "type": "string", "minLength": 1 },
        "execution_fingerprint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "patternProperties": { "^x-": {} }
    },
    "sample_manifest_row": {
      "type": "object",
      "required": ["set_id", "case_id", "hash"],
      "properties": {
        "set_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 },
        "session_group": { "type": ["string", "null"] }
      },
      "additionalProperties": true,
      "patternProperties": { "^x-": {} }
    },
    "evaluation_plan": {
      "type": "object",
      "required": ["plan_id", "sample_manifest"],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "schema": { "type": "string" },
        "sample_manifest": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sample_manifest_row" }
        },
        "manifest_hash": { "type": "string" },
        "execution_fingerprint": { "type": "string" },
        "selected_cases": {
          "type": "array",
          "description": "Legacy projection only; MUST NOT be sole execution list"
        },
        "claims_policy": {
          "type": "object",
          "properties": {
            "accuracy_claim": { "type": "boolean", "const": false },
            "sufficiency_claim": { "type": "boolean" },
            "claim_eligible": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "patternProperties": { "^x-": {} }
    },
    "case_pack": {
      "type": "object",
      "required": ["pack_id", "version", "kind", "claim_eligible", "pack_hash"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["gold", "generated", "trace", "exploratory", "fixture", "unknown"]
        },
        "claim_eligible": { "type": "boolean" },
        "pack_hash": { "type": "string", "minLength": 1 },
        "scope": { "type": "string" },
        "object_types": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true,
      "patternProperties": { "^x-": {} },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "enum": ["generated", "trace", "exploratory"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "claim_eligible": { "const": false } }
          }
        }
      ]
    },
    "eval_result": {
      "type": "object",
      "required": [
        "plan_id",
        "manifest_hash",
        "execution_fingerprint",
        "dimensions",
        "evidence_refs",
        "claim_eligible"
      ],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "manifest_hash": { "type": "string", "minLength": 1 },
        "execution_fingerprint": { "type": "string", "minLength": 1 },
        "score": { "type": ["number", "null"] },
        "dimensions": {
          "oneOf": [
            { "type": "object", "minProperties": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "claim_eligible": { "type": "boolean", "default": false },
        "accuracy_claim": { "type": "boolean", "default": false },
        "fingerprints": { "$ref": "#/$defs/fingerprints" }
      },
      "additionalProperties": true,
      "patternProperties": { "^x-": {} }
    },
    "gate_result": {
      "type": "object",
      "required": ["ok", "fingerprints"],
      "properties": {
        "ok": { "type": "boolean" },
        "fingerprints": { "$ref": "#/$defs/fingerprints" },
        "schema": { "type": "string" },
        "accuracy_claim": { "type": "boolean", "default": false },
        "gates": { "type": "object" },
        "missing": { "type": "array", "items": { "type": "string" } },
        "failed": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      },
      "additionalProperties": true,
      "patternProperties": { "^x-": {} }
    },
    "approval_record": {
      "type": "object",
      "required": [
        "standard_version",
        "scope",
        "status",
        "approvers",
        "approval_date",
        "effective_date",
        "decision",
        "record_id"
      ],
      "properties": {
        "standard_version": { "type": "string" },
        "scope": { "type": "string" },
        "status": { "enum": ["pending", "approved", "rejected"] },
        "approvers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "approval_date": { "type": "string" },
        "effective_date": { "type": "string" },
        "exceptions": { "type": "array" },
        "conflict_waiver": { "type": "object" },
        "decision": { "type": "string" },
        "record_id": { "type": "string" },
        "honesty": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
