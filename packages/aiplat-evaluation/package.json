{
  "name": "aiplat-evaluation",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation Service D1c cohost + A1–A5 local standalone/closeout. process_split_authorized=false.",
  "capability_id": "evaluation",
  "deploy_unit": "central",
  "hosted_by": "aiplat",
  "scripts": {
    "start:local": "bash scripts/run_local.sh",
    "migrate:local": "bash scripts/migrate_local.sh",
    "independence": "bash scripts/independence_check.sh",
    "backup:local": "bash scripts/backup_local.sh",
    "rollback:local": "bash scripts/rollback_local.sh",
    "closeout:a5": "bash scripts/a5_local_closeout.sh",
    "test:a1": "PYTHONPATH=. python3 -m pytest tests/test_a1_standalone_healthz.py -q",
    "test:a2": "PYTHONPATH=. python3 -m pytest tests/test_a2_local_store.py -q",
    "test:a3": "PYTHONPATH=. python3 -m pytest tests/test_a3_canonical_store_api.py -q",
    "test:a4": "PYTHONPATH=. python3 -m pytest tests/test_a4_independence.py -q",
    "test:a5": "PYTHONPATH=. python3 -m pytest tests/test_a5_backup_rollback.py -q"
  }
}
