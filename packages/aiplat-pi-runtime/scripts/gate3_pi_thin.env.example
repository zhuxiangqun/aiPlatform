# Gate3 Pi Thin pilot — independent process env (NOT control-plane .env)
# Copy: cp scripts/gate3_pi_thin.env.example .env.gate3-pi-thin
# Load: set -a && source .env.gate3-pi-thin && set +a
# Hard rule: do NOT set AIPLAT_ENTERPRISE=1 here (control plane stays separate).

AIPLAT_HTTP_STUB=1
AIPLAT_HTTP_PORT=18787
# Loopback default; compose sets 0.0.0.0 for published ports
AIPLAT_HTTP_HOST=127.0.0.1
AIPLAT_HTTP_API_KEY=gate3-pi-thin-pilot-key
AIPLAT_APP_HOME=

# Leave unset / empty for stub DoD. Optional agent probe later:
# AIPLAT_PI_MODEL=
# AIPLAT_PI_BASE_URL=
# AIPLAT_PI_API_KEY=

# Explicitly refuse enterprise bundle in this process:
AIPLAT_ENTERPRISE=0
