# ADR-09 Pi Thin optional-deploy env alias (name convergence).
# Canonical content: gate3_pi_thin.env.example — copy either file to .env.gate3-pi-thin
# (pilot script still loads .env.gate3-pi-thin by default).
#
#   cp scripts/pi_thin_optional.env.example .env.gate3-pi-thin
#   # or: cp scripts/gate3_pi_thin.env.example .env.gate3-pi-thin
#
# See reports/five-products/ADR09_PI_THIN_BOUNDARY.md
# NOT forced production default; NOT compose long-running.

# --- identical defaults to gate3_pi_thin.env.example ---
AIPLAT_HTTP_STUB=1
AIPLAT_HTTP_PORT=18787
AIPLAT_HTTP_HOST=127.0.0.1
AIPLAT_HTTP_API_KEY=gate3-pi-thin-pilot-key
AIPLAT_APP_HOME=
AIPLAT_ENTERPRISE=0
