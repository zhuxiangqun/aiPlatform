# aiPlat 环境配置
# 复制此文件为 .env 并修改

# ===== LLM 配置（必填） =====
AIPLAT_LLM_PROVIDER=deepseek
AIPLAT_LLM_BASE_URL=https://api.deepseek.com/v1
AIPLAT_LLM_API_KEY=sk-your-api-key-here

# ===== LLM 推理模型 =====
AIPLAT_REASONING_MODEL=deepseek-chat

# ===== 数据目录 =====
AIPLAT_HOME=/app/.aiplat

# ===== 浏览器自动化 =====
BROWSER_USE_HEADLESS=true
