# ============================================================
# aiPlat 环境配置 — 客户部署模板
# 复制为 .env 后填入实际值
# ============================================================

# --- Core AI Engine (port 8002) ---
AIPLAT_SKILL_STRICT_VALIDATION=false
AIPLAT_RBAC_MODE=warn

# --- LLM API Keys (按需配置) ---
# OPENAI_API_KEY=sk-xxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Ollama (本地模型) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 若 Ollama 与 Docker 不在同一机器，改为实际 IP

# --- 数据库 ---
AIPLAT_DB_PATH=/data/aiplat

# --- 管理员初始账户（首次启动时创建） ---
AIPLAT_ADMIN_USERNAME=admin
AIPLAT_ADMIN_PASSWORD=changeme

# --- 网络/端口 ---
AIPLAT_PORT_SERVICES="8002:core,8001:infra,8003:platform,8004:app,8000:management,5173:frontend"

# --- 存储路径 ---
AIPLAT_STORAGE_BUCKET=aiplat-data

# --- 监控 ---
AIPLAT_METRICS_NAMESPACE=aiplat-production
AIPLAT_SERVICE_NAME=aiplat-deployment

# --- 通知 (可选) ---
# AIPLAT_SMTP_HOST=smtp.example.com
# AIPLAT_SMTP_PORT=587
# AIPLAT_SMTP_USER=noreply@example.com
# AIPLAT_SMTP_PASS=password
