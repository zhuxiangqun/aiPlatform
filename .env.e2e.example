# E2E smoke env example (DO NOT put real secrets in git)
#
# Usage:
#   cp .env.e2e.example .env.e2e
#   # edit .env.e2e and fill your key
#   ./e2e_smoke.sh
#
# DeepSeek (OpenAI-compatible)
AIPLAT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-REPLACE_ME

# Default agent model for e2e (推理模型)
AIPLAT_AGENT_MODEL=deepseek-reasoner

# Optional overrides
# AIPLAT_LLM_BASE_URL=https://api.deepseek.com/v1
# AIPLAT_LLM_MODEL=deepseek-reasoner

# ── Security ──
# AIPLAT_JWT_SECRET=your-jwt-secret-here  # REQUIRED for production JWT verification
# AIPLAT_SKILL_INSTALL_PLAN_SECRET=  # Signing secret for skill install plan tokens

# ── Sandbox / Execution ──
# AIPLAT_SANDBOX_DOCKER_IMAGE=python:3.12-slim
# AIPLAT_EXEC_BACKEND=  # "ssh" | "docker" | "" (local)

# ── Skill Permissions ──
# AIPLAT_SKILL_PERMISSION_RULES=  # JSON string of skill_id→permission mappings
# AIPLAT_EXEC_SKILL_PERMISSION_RULES=  # Execution-time override

# ── Scripted / Testing ──
# AIPLAT_SCRIPTED_LLM_RESPONSES=  # Path to JSON file with canned LLM responses
# AIPLAT_SCRIPTED_LLM_DEFAULT_USAGE=  # Default usage value for scripted adapter

# ── Gateway ──
# AIPLAT_GATEWAY_TOKEN=  # Shared secret for gateway auth

# ── Timeouts ──
# AIPLAT_LLM_TIMEOUT_SECONDS=180

# ── CORS ──
# AIPLAT_CORS_ORIGINS=http://localhost:3000
# AIPLAT_CORS_CREDENTIALS=false  # Must be false when origins is "*"
# AIPLAT_MANAGEMENT_CORS_ORIGINS=http://localhost:3000
# AIPLAT_MANAGEMENT_CORS_CREDENTIALS=false

# ── MCP / Tool ──
# AIPLAT_MCP_STDIO_ALLOWLIST=  # Comma-separated list of allowed MCP commands
# AIPLAT_TECH_KEYWORD_PATTERNS=  # Extra tech keywords (||-separated regex patterns)

# ── Prompt Audit ──
# AIPLAT_AUDIT_AGENT_PROMPT=true  # Audit AGENT.md for vague adjectives + missing handoff (default: on)


