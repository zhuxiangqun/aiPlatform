    "api_contracts": {
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/v1/projects",
          "description": "创建新项目（对应U1）",
          "request_body": {
            "name": "string (可选)",
            "description": "string (必填)",
            "team_members": [
              {
                "user_id": "string (UUID)",
                "role": "string"
              }
            ]
          },
          "response_body": {
            "project": {
              "id": "string (UUID)",
              "status": "string",
              "name": "string",
              "description": "string",
              "created_by": "string (UUID)",
              "created_at": "datetime",
              "updated_at": "datetime",
              "team_members": [
                {
                  "user_id": "string (UUID)",
                  "role": "string"
                }
              ]
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/projects/{project_id}/conversations",
          "description": "为指定项目阶段创建一个新的对话会话",
          "query_parameters": {
            "stage": "string (必填) - 阶段名称，如 'REQUIREMENT_GATHERING'"
          },
          "response_body": {
            "conversation": {
              "id": "string (UUID)",
              "project_id": "string (UUID)",
              "stage": "string",
              "status": "string",
              "created_at": "datetime",
              "updated_at": "datetime"
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/conversations/{conversation_id}/messages",
          "description": "向指定对话发送一条消息（用户或Agent）",
          "request_body": {
            "sender_type": "string (必填) - 'USER' 或 'AGENT'",
            "sender_id": "string (UUID) (必填)",
            "content": "string (必填)"
          },
          "response_body": {
            "message": {
              "id": "string (UUID)",
              "conversation_id": "string (UUID)",
              "sender_type": "string",
              "sender_id": "string (UUID)",
              "content": "string",
              "created_at": "datetime"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/conversations/{conversation_id}/messages",
          "description": "获取指定对话的所有消息历史",
          "response_body": {
            "messages": [
              {
                "id": "string (UUID)",
                "conversation_id": "string (UUID)",
                "sender_type": "string",
                "sender_id": "string (UUID)",
                "content": "string",
                "created_at": "datetime"
              }
            ]
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/projects/{project_id}/actions/confirm",
          "description": "用户确认当前阶段产物（如PRD、架构图、测试用例），进入下一阶段",
          "request_body": {
            "stage": "string (必填) - 要确认的阶段，如 'REQUIREMENT_REVIEW'",
            "user_id": "string (UUID) (必填)"
          },
          "response_body": {
            "success": "boolean",
            "next_stage": "string"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/projects/{project_id}/actions/reject",
          "description": "用户拒绝当前阶段产物，并提供修改意见",
          "request_body": {
            "stage": "string (必填) - 要拒绝的阶段",
            "user_id": "string (UUID) (必填)",
            "feedback": "string (必填) - 修改意见"
          },
          "response_body": {
            "success": "boolean",
            "action": "string - 描述系统将如何处理拒绝，如 '重新进入需求收集阶段'"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/projects/{project_id}/trigger/test",
          "description": "手动或自动触发测试执行（对应U4）",
          "response_body": {
            "test_report_id": "string (UUID)"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/projects/{project_id}/test-reports/{report_id}",
          "description": "获取指定测试报告的详细信息",
          "response_body": {
            "test_report": {
              "id": "string (UUID)",
              "project_id": "string (UUID)",
              "total_cases": "integer",
              "passed_cases": "integer",
              "failed_cases": "integer",
              "pass_rate": "float",
              "details": [
                {
                  "test_case_id": "string",
                  "status": "string",
                  "error_log": "string"
                }
              ],
              "created_at": "datetime"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/projects/{project_id}/bugs",
          "description": "获取项目的所有Bug记录（对应U5）",
          "response_body": {
            "bugs": [
              {
                "id": "string (UUID)",
                "project_id": "string (UUID)",
                "test_report_id": "string (UUID)",
                "test_case_id": "string",
                "error_log": "string",
                "status": "string",
                "fix_info": {
                  "fix_date": "datetime",
                  "fix_method": "string",
                  "program_name": "string"
                },
                "created_at": "datetime",
                "fixed_at": "datetime"
              }
            ]
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/projects/{project_id}/bugs/{bug_id}/fix",
          "description": "记录一个Bug的修复信息（由代码修复Agent调用）",
          "request_body": {
            "fix_method": "string (必填)",
            "program_name": "string (必填)"
          },
          "response_body": {
            "bug": {
              "id": "string (UUID)",
              "status": "string",
              "fix_info": {
                "fix_date": "datetime",
                "fix_method": "string",
                "program_name": "string"
              },
              "fixed_at": "datetime"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/projects/{project_id}/audit-logs",
          "description": "获取项目的审计日志",
          "response_body": {
            "audit_logs": [
              {
                "id": "string (UUID)",
                "project_id": "string (UUID)",
                "action": "string",
                "actor_type": "string",
                "actor_id": "string (UUID)",
                "details": "json",
                "timestamp": "datetime"
              }
            ]
          }
        }
      ]
    }
  },
  "_stage_backend_developer_4_done": true
