# ADR-10 diagnosis MVP pilot — independent sandbox env (NOT control-plane .env)
# Copy (optional): cp scripts/adr10_diagnosis_mvp.env.example .env.adr10-diagnosis-mvp
# Hard rule: do NOT set AIPLAT_DIAGNOSIS_PROD_DEFAULT=1 (forbids prod default-path switch).

# Sandbox data root (must stay under /tmp unless ADR10_ALLOW_USER_HOME=1)
ADR10_DIAG_AIPLAT_HOME=/tmp/aiplat-adr10-diag-home

AIPLAT_SLICE_SCENARIO_ID=fp-customer-lock-service-bundle-pi-diag-001

# Leave unset / 0 — production default path switch is out of ADR-10 Phase A
# AIPLAT_DIAGNOSIS_PROD_DEFAULT=0
